---
import { brandSlots } from '../data/content';

// Логотипы в один цвет, чтобы полоса не спорила с фотографиями товаров.
// В демо — обезличенные силуэты: чужие марки в шаблон класть нельзя.
const track = [...brandSlots, ...brandSlots];
---

<section class="brands" aria-label="Поставщики">
  <p class="brands__label t-micro">Только официальные поставщики</p>
  <div class="brands__view">
    <div class="brands__track">
      {
        track.map((slot, i) => (
          <span class="brands__item" aria-hidden={i >= brandSlots.length ? 'true' : undefined}>
            <svg viewBox="0 0 120 28" width="120" height="28" role="img" aria-label={slot.label}>
              <rect x="0" y="6" width="26" height="16" rx="2" fill="currentColor" opacity=".55" />
              <rect x="32" y="9" width="52" height="4" rx="2" fill="currentColor" opacity=".5" />
              <rect x="32" y="17" width="34" height="4" rx="2" fill="currentColor" opacity=".3" />
              <circle cx="104" cy="14" r="8" fill="none" stroke="currentColor" stroke-width="2" opacity=".4" />
            </svg>
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .brands {
    position: relative;
    height: 84px;
    display: flex;
    align-items: center;
    border-block: 1px solid var(--c-line);
    overflow: hidden;
  }
  .brands__label {
    position: absolute;
    left: var(--gutter);
    z-index: 2;
    text-transform: uppercase;
    background: var(--c-paper);
    padding-right: 20px;
    white-space: nowrap;
    display: none;
  }
  .brands__view {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .brands__track {
    display: flex;
    align-items: center;
    gap: 64px;
    width: max-content;
    animation: marquee 40s linear infinite;
    color: var(--c-ink);
    opacity: 0.55;
  }
  .brands:hover .brands__track {
    animation-play-state: paused;
  }
  .brands__item {
    flex: none;
    display: grid;
    place-items: center;
  }

  @media (min-width: 900px) {
    .brands__label {
      display: block;
    }
    .brands__view {
      padding-left: 300px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brands__track {
      animation: none;
    }
  }
</style>
